function chooseChar(cid) {
  SFX.click();
  const c = CHARACTERS.find(ch => ch.id === cid);
  players.push({
    playerNum: selectingPlayerIndex + 1, id: c.id, name: c.name, role: c.role, color: c.color,
    str: c.str, spd: c.spd, kno: c.kno, san: c.san, origSan: c.san,
    maxHp: c.str + c.spd, hp: c.str + c.spd, talent: c.talent,
    pos: { x: 0, y: 0 }, prevPos: { x: 0, y: 0 }, inventory: [],
    currentSteps: c.spd, isDead: false, turnActions: { attack: false, item: false }
  });
  selectingPlayerIndex++;
  if (selectingPlayerIndex < totalPlayerCount) startCharSelect();
  else startGame();
}

