function spawnPowerBoxes(bossTile) {
  powerBoxes = [];
  const coords = [{x: -2, y: -2}, {x: 2, y: 2}, {x: 2, y: -2}];
  coords.forEach((c) => {
    const k = `${c.x},${c.y}`;
    if (!mapGrid[k]) {
      const t = new Tile(c.x, c.y, "變電箱機房");
      t.explored = true; t.doors = {top:true, right:true, bottom:true, left:true};
      mapGrid[k] = t;
    }
    powerBoxes.push({ x: c.x, y: c.y, active: true });
  });
  log(`⚡ 地圖上散落了 3 處【變電箱】！必須前往關閉，否則無人機將無限增殖！`, "boss");
}

function spawnDrones(bossTile) {
  drones = [];
  const count = totalPlayerCount;
  for (let i = 0; i < count; i++) {
    drones.push({ x: bossTile.x + (i % 2 === 0 ? 1 : -1), y: bossTile.y });
  }
}

function spawnCultists() {
  cultists = [];
  const count = Math.max(1, totalPlayerCount);
  for (let i = 0; i < count; i++) {
    cultists.push({ x: (i % 2 === 0 ? 2 : -2), y: (i % 2 === 0 ? -1 : 1), str: 2 });
  }
}

function performBasicAttack() {
  const p = getCurPlayer();
  if (!activeBoss || p.turnActions.attack) return;
  const dist = Math.abs(p.pos.x - activeBoss.x) + Math.abs(p.pos.y - activeBoss.y);
  if (dist > 1) { log("距離過遠！肉搏重拳只能在相鄰 1 格內使用！", "event"); return; }

  modalState = "attack_check";
  const content = document.getElementById("modal-content");
  document.getElementById("modal").style.display = "flex";

  content.innerHTML = `
    <h3 style="color:#ff4757; font-size:1.15rem;">⚔️ 肉搏力量檢定</h3>
    <div class="dice-stage"><div class="dice-box" id="atkDiceBox">?</div></div>
    <div style="background:rgba(0,0,0,0.3); padding:8px; border-radius:5px; font-size:0.8rem; margin-bottom:10px;">
      公式：(D6 + 你的力氣 ${p.str}) - Boss力氣 (${activeBoss.str})
    </div>
    <button id="btnRollAtk" onclick="rollAttackDice(${p.str})" style="background:#e74c3c; color:#fff; padding:8px 24px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">🎲 擲骰出拳！</button>
  `;
}

function rollAttackDice(str) {
  const diceBox = document.getElementById("atkDiceBox");
  if (diceBox) diceBox.classList.add("dice-rolling");
  let cnt = 0;
  const itv = setInterval(() => {
    if (diceBox) diceBox.innerText = Math.floor(Math.random() * 6) + 1;
    cnt++; SFX.diceRoll();
    if (cnt > 12) { clearInterval(itv); finalizeAttackRoll(str); }
  }, 70);
}

function finalizeAttackRoll(str) {
  const p = getCurPlayer();
  const diceBox = document.getElementById("atkDiceBox");
  if (diceBox) diceBox.classList.remove("dice-rolling");
  const roll = Math.floor(Math.random() * 6) + 1;
  if (diceBox) diceBox.innerText = roll;
  const total = roll + str;
  p.turnActions.attack = true;
  const content = document.getElementById("modal-content");

  if (total > activeBoss.str) {
    const dmg = total - activeBoss.str;
    activeBoss.hp = Math.max(0, activeBoss.hp - dmg);
    SFX.punchAttack(); addSlashEffect(activeBoss.x, activeBoss.y); addFloatingText(activeBoss.x, activeBoss.y, `-${dmg} HP!`, "#ff4757", 22);
    triggerScreenShake(7); triggerDamageFlash("boss");
    content.innerHTML = `
      <div style="color:#2ed573; font-weight:bold; font-size:1rem; margin-bottom:8px;">💥 突破防禦！造成 ${dmg} 點重創！</div>
      <button onclick="closeModal()" style="background:#2ed573; color:#111; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">確認</button>
    `;
    if (activeBoss.hp <= 0) { showEndingVictoryStory(activeBoss.route); }
    updateUI();
  } else {
    SFX.diceFail(); addFloatingText(activeBoss.x, activeBoss.y, "DEFEND / 0 DMG", "#a4b0be", 18);
    content.innerHTML = `
      <div style="color:#ff4757; font-weight:bold; font-size:1rem; margin-bottom:8px;">🛡️ 攻擊被彈開 (0 傷害)</div>
      <button onclick="closeModal()" style="background:#57606f; color:#fff; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">返回</button>
    `;
    updateUI();
  }
}

// 每回合限用一個道具 (問題 3 實裝)
function useItem(idx) {
  const p = getCurPlayer();
  const it = p.inventory[idx];
  if (it.type === "armor_san" || it.type === "armor_str") {
    alert(`【${it.name}】為常駐防具，佩戴即可自動減免傷害，無法主動使用！`); return;
  }
  if (p.turnActions.item) {
    alert("⚠️ 每回合限使用一個道具！請等待下一回合。");
    return;
  }

  p.turnActions.item = true;

  if (it.type === "heal") {
    p.hp = Math.min(p.maxHp, p.hp + 3); p.inventory.splice(idx, 1);
    addFloatingText(p.pos.x, p.pos.y, "+3 HP", "#2ed573", 20);
    log(`💊 使用急救箱，HP 恢復 3 點！`, "item");
  } else if (gamePhase === "combat" && activeBoss) {
    activeBoss.hp = Math.max(0, activeBoss.hp - 6); p.inventory.splice(idx, 1);
    SFX.bladeSlash(); addFloatingText(activeBoss.x, activeBoss.y, "-6 HP!", "#ff4757", 22);
    log(`💥 戰術道具重創 Boss 6 點傷害！`, "boss");
    if (activeBoss.hp <= 0) { showEndingVictoryStory(activeBoss.route); return; }
  }
  updateUI();
}

function checkPlayerDown(targetP) {
