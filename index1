function generateTile(x, y, fromDir) {
  const name = ROOM_NAMES[Math.floor(Math.random() * ROOM_NAMES.length)];
  const tile = new Tile(x, y, name);
  
  if (fromDir === "top") tile.doors.bottom = true;
  if (fromDir === "bottom") tile.doors.top = true;
  if (fromDir === "left") tile.doors.right = true;
  if (fromDir === "right") tile.doors.left = true;
  ["top", "right", "bottom", "left"].forEach(d => { if (Math.random() < 0.65) tile.doors[d] = true; });

  const rand = Math.random();
  if (rand < 0.45) {
    tile.hasEvent = EVENTS_POOL[Math.floor(Math.random() * EVENTS_POOL.length)];
  } else if (rand < 0.78) {
    const availableItems = ITEMS_POOL.filter(item => {
      if (!item.isKey) return true;
      return !claimedGlobalItemIds.has(item.id);
    });
    if (availableItems.length > 0) {
      const selected = availableItems[Math.floor(Math.random() * availableItems.length)];
      tile.hasItem = JSON.parse(JSON.stringify(selected));
      if (selected.isKey) claimedGlobalItemIds.add(selected.id);
    } else {
      tile.hasItem = JSON.parse(JSON.stringify(ITEMS_POOL.find(i => i.id === "item_med")));
    }
  }

  totalRoomsExplored++;
  return tile;
}

function tryMove(dx, dy) {
  const p = getCurPlayer();
  if (!p || p.isDead || modalState !== null) return;

  if (p.currentSteps <= 0) {
    log(`⚠️ P${p.playerNum} 步數已用盡！請點擊【換下一位行動】結束回合。`, "event");
    triggerScreenShake(3);
    return;
  }

  const curTile = mapGrid[`${p.pos.x},${p.pos.y}`];
  let dir = dx===0 ? (dy===-1?"top":"bottom") : (dx===-1?"left":"right");
  if (!curTile.doors[dir]) {
    log("碰！眼前是厚實水泥牆！", "event");
    triggerScreenShake(3);
    return;
  }

  const targetKey = `${p.pos.x+dx},${p.pos.y+dy}`;
  let targetTile = mapGrid[targetKey];
  let isFirstEnter = false;

  if (!targetTile) {
    targetTile = generateTile(p.pos.x+dx, p.pos.y+dy, dir);
    mapGrid[targetKey] = targetTile;
    isFirstEnter = true;
  }

  p.pos.x += dx; p.pos.y += dy;
  p.currentSteps--;
  SFX.move();

  if (electrifiedRoomKey === `${p.pos.x},${p.pos.y}`) {
    p.currentSteps = Math.max(0, p.currentSteps - 1);
    log(`⚡ 踩入 AI母體通電房間！額外消耗 1 步！`, "boss");
    applyDamageToPlayer(p, 1, "通電地板電擊");
  }

  updateUI();
  log(`【P${p.playerNum} ${p.name}】踏入【${targetTile.name}】(剩餘步數: ${p.currentSteps})`, "action");

  if (isFirstEnter) {
    targetTile.explored = true;
    if (checkBossTrigger(targetTile)) return;
    
    if (targetTile.hasItem) {
      showItemPickupModal(targetTile.hasItem);
      targetTile.hasItem = null;
      p.currentSteps = 0;
      updateUI();
      return;
    }
    if (targetTile.hasEvent) {
      triggerEvent(targetTile.hasEvent);
      targetTile.hasEvent = null;
      p.currentSteps = 0;
      updateUI();
      return;
    }
  }
}

