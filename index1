function updateUI() {
  const p = getCurPlayer();
  if (!p) return;
  p.maxHp = p.str + p.spd;
  document.getElementById("p-name").innerText = p.name;
  document.getElementById("p-hp").innerText = `${p.hp} / ${p.maxHp}`;
  document.getElementById("p-hp-fill").style.width = `${Math.max(0, (p.hp/p.maxHp)*100)}%`;

  const stepCountEl = document.getElementById("p-step-count");
  const stepBadge = document.getElementById("p-step-badge");
  stepCountEl.innerText = `${p.currentSteps} 步`;
  if (p.currentSteps <= 0) {
    stepBadge.classList.add("no-steps");
    stepCountEl.innerText = "0 步 (請換人)";
  } else {
    stepBadge.classList.remove("no-steps");
  }

  document.getElementById("p-str").innerText = p.str;
  document.getElementById("p-spd").innerText = p.spd;
  document.getElementById("p-kno").innerText = p.kno;
  document.getElementById("p-san").innerText = p.san;

  renderInlineInventory();
  renderPlayerTabs();
  if (activeBoss) {
    document.getElementById("boss-mini-bar").style.display = "flex";
    document.getElementById("b-name").innerText = activeBoss.name;
    document.getElementById("b-hp").innerText = activeBoss.hp;
    document.getElementById("b-str").innerText = activeBoss.str;

    if (activeBoss.route === "C") {
      const altar = cultAltars.find(a => a.x === p.pos.x && a.y === p.pos.y && !a.destroyed);
      const container = document.getElementById("altar-action-container");
      if (altar) {
        container.style.display = "block";
      } else {
        container.style.display = "none";
      }
    }
  }
}

