    display: none;
    background: rgba(255, 71, 87, 0.15);
    border: 1px solid #ff4757;
    border-radius: 4px;
    padding: 2px 4px;
    margin-bottom: 2px;
    font-size: 0.65rem;
    justify-content: space-between;
    align-items: center;
  }
  .control-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .control-grid button {
    background: #252c3d;
    color: white;
    border: 1px solid #3d4a66;
    padding: 10px 2px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.8rem;
    touch-action: manipulation;
  }
  .control-grid button:active { background: #4a5a7d; transform: scale(0.96); }
  .btn-turn { background: #d63031 !important; border-color: #ff7675 !important; width: 100%; padding: 7px 2px !important; font-size: 0.75rem !important; margin-top: 2px; }
  .drawer-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7); z-index: 500; display: none; justify-content: center; align-items: flex-end;
  }
  .drawer-content { background: #181f2f; border-top: 2px solid var(--player-theme); border-radius: 12px 12px 0 0; width: 100%; max-height: 65vh; padding: 14px; overflow-y: auto; }
  .shake-screen { animation: screenShake 0.35s ease-in-out; }
  @keyframes screenShake {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(-6px, 4px); }
    40% { transform: translate(6px, -4px); }
    60% { transform: translate(-4px, -2px); }
    80% { transform: translate(4px, 2px); }
  }
  .flash-red { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 0, 0, 0.35); pointer-events: none; z-index: 50; animation: fadeOut 0.4s forwards; }
  .flash-white { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.45); pointer-events: none; z-index: 50; animation: fadeOut 0.3s forwards; }
  @keyframes fadeOut { 0% { opacity: 1; } 100% { opacity: 0; } }
  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.88); display: flex; justify-content: center; align-items: center; z-index: 9999;
  }
  .modal-box {
    background: #1a202c; border: 2px solid #4a5568; border-radius: 10px;
    width: 580px; max-width: 94vw; padding: 16px; text-align: center; max-height: 90vh; overflow-y: auto;
