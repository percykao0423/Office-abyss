function applyCurrentPlayer() {
  const p = getCurPlayer();
  if (!p) return;
  document.documentElement.style.setProperty('--player-theme', p.color);
  document.getElementById("current-player-title").innerText = `P${p.playerNum}: ${p.name}`;
  document.getElementById("current-player-title").style.color = p.color;

  const cvs = document.getElementById("active-char-canvas");
  if (cvs) {
    const ctx = cvs.getContext("2d");
    ctx.clearRect(0, 0, cvs.width, cvs.height);
    drawMiniCharacterSprite(ctx, p.id, 18, 25, 0.95);
