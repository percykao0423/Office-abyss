function endTurn() {
  if (modalState !== null) return;
  const p = getCurPlayer();
  if (!p) return;
  p.turnActions.attack = false; p.turnActions.item = false;
  log(`--- 玩家 P${p.playerNum} 結束行動 ---`, "action");

  let nextIdx = (currentPlayerIndex + 1);
  let allDone = false;
  if (nextIdx >= players.length) { allDone = true; nextIdx = 0; }

  if (allDone) {
    if (gamePhase === "combat" && activeBoss && activeBoss.hp > 0) {
      bossAction();
    }
    players.forEach(pl => { if (!pl.isDead) pl.currentSteps = pl.spd; });
  }

  let safetyCounter = 0;
  while (players[nextIdx].isDead && safetyCounter < players.length) {
    nextIdx = (nextIdx + 1) % players.length;
    safetyCounter++;
  }

  currentPlayerIndex = nextIdx;
  applyCurrentPlayer();
}

function bossAction() {
  log(`👹 Boss 【${activeBoss.name}】與手下開始行動...`, "boss");
  const alive = players.filter(pl => !pl.isDead);
  if (alive.length === 0) return;

  if (activeBoss.route === "B") {
    const keys = Object.keys(mapGrid);
    electrifiedRoomKey = keys[Math.floor(Math.random() * keys.length)];
    log(`⚡ 【母體高壓電網】房間 [${mapGrid[electrifiedRoomKey]?.name || electrifiedRoomKey}] 地面通電！`, "boss");

    const activeBoxesCount = powerBoxes.filter(b => b.active).length;
    if (activeBoxesCount > 0) {
      const droneCount = totalPlayerCount;
      for (let i = 0; i < droneCount; i++) { drones.push({ x: activeBoss.x, y: activeBoss.y }); }
      log(`🤖 變電箱未關閉！主控母體增殖產出 ${droneCount} 架【自爆無人機】！`, "boss");
    }

    alive.forEach(pl => {
      const pb = powerBoxes.find(b => b.x === pl.pos.x && b.y === pl.pos.y && b.active);
      if (pb) {
        pb.active = false;
        log(`⚡【${pl.name}】成功關閉一處變電箱！(剩餘未關閉: ${powerBoxes.filter(b=>b.active).length}/3)`, "item");
      }
    });
  }

  drones.forEach((d, idx) => {
    let targetP = alive[0]; let minD = 999;
    alive.forEach(pl => {
      const dist = Math.abs(pl.pos.x - d.x) + Math.abs(pl.pos.y - d.y);
      if (dist < minD) { minD = dist; targetP = pl; }
    });
    if (d.x < targetP.pos.x) d.x++; else if (d.x > targetP.pos.x) d.x--;
    if (d.y < targetP.pos.y) d.y++; else if (d.y > targetP.pos.y) d.y--;

    if (d.x === targetP.pos.x && d.y === targetP.pos.y) {
      log(`🤖 自爆無人機撞擊【${targetP.name}】爆炸！`, "boss");
      drones.splice(idx, 1);
      applyDamageToPlayer(targetP, 2, "無人機自爆破片");
    }
  });

  cultists.forEach(c => {
    let targetP = alive[0]; let minD = 999;
    alive.forEach(pl => {
      const dist = Math.abs(pl.pos.x - c.x) + Math.abs(pl.pos.y - c.y);
      if (dist < minD) { minD = dist; targetP = pl; }
    });
    if (c.x < targetP.pos.x) c.x++; else if (c.x > targetP.pos.x) c.x--;
    if (c.y < targetP.pos.y) c.y++; else if (c.y > targetP.pos.y) c.y--;

    if (c.x === targetP.pos.x && c.y === targetP.pos.y) {
      const roll = Math.floor(Math.random() * 6) + 1;
      const totalPower = roll + targetP.str;
      if (totalPower >= 2) {
        log(`⚔️【${targetP.name}】與【黑暗信徒】力量檢定通過 (總計${totalPower} ≥ 2)，將信徒擊退！`, "talent");
      } else {
        log(`👥【黑暗信徒】突襲【${targetP.name}】！力量檢定失敗，受到傷害！`, "boss");
        applyDamageToPlayer(targetP, 1, "黑暗信徒精神抓傷");
      }
    }
  });

  if (!activeBoss.canMove) {
    log(`👾 主控 AI【全知母體】固定於中央核心不動！`, "boss");
    updateUI(); return;
  }

  let targetP = alive[0]; let minD = 999;
  alive.forEach(pl => {
    const d = Math.abs(pl.pos.x - activeBoss.x) + Math.abs(pl.pos.y - activeBoss.y);
    if (d < minD) { minD = d; targetP = pl; }
  });

  const dist = Math.abs(targetP.pos.x - activeBoss.x) + Math.abs(targetP.pos.y - activeBoss.y);
  if (dist <= 3) {
    activeBoss.x = targetP.pos.x; activeBoss.y = targetP.pos.y;
    SFX.bossHitPlayer(); triggerScreenShake(7); triggerDamageFlash("player");
    log(`🚨 Boss 狂暴衝撞【${targetP.name}】！`, "boss");
    applyDamageToPlayer(targetP, 3, "Boss 狂暴衝撞");
  } else {
    let dx = targetP.pos.x - activeBoss.x; let dy = targetP.pos.y - activeBoss.y;
    if (Math.abs(dx) > Math.abs(dy)) activeBoss.x += dx > 0 ? 1 : -1;
    else if (dy !== 0) activeBoss.y += dy > 0 ? 1 : -1;
  }
  updateUI();
}

function openDrawer(type) {
  const overlay = document.getElementById("drawerOverlay");
  const title = document.getElementById("drawerTitle");
  const body = document.getElementById("drawerBody");
  overlay.style.display = "flex";
  title.innerText = "📜 空間動態日誌";
  let h = `<div style="display:flex; flex-direction:column; gap:4px; max-height:45vh; overflow-y:auto;">`;
  gameLogs.slice().reverse().forEach(l => {
    h += `<div style="font-size:0.72rem; padding:4px 6px; background:rgba(255,255,255,0.04); border-left:2px solid #57606f; border-radius:3px;">${l}</div>`;
  });
  h += `</div>`; body.innerHTML = h;
}
function closeDrawer() { document.getElementById("drawerOverlay").style.display = "none"; }

function triggerScreenShake(mag = 6) {
  const container = document.getElementById("canvasWrapper");
  container.classList.remove("shake-screen"); void container.offsetWidth; container.classList.add("shake-screen");
  setTimeout(() => container.classList.remove("shake-screen"), 350);
}
function triggerDamageFlash(type = "player") {
  const wrapper = document.getElementById("canvasWrapper");
  const flash = document.createElement("div");
  flash.className = type === "player" ? "flash-red" : "flash-white";
  wrapper.appendChild(flash);
  setTimeout(() => { if (flash.parentNode) flash.parentNode.removeChild(flash); }, 400);
}
function addFloatingText(x, y, text, color = "#fff", size = 18) {
  visualEffects.push({ type: "text", x, y, offsetY: 0, text, color, size, alpha: 1.0, life: 45 });
}
function addSlashEffect(x, y, color = "#fffa65") {
  visualEffects.push({ type: "slash", x, y, color, life: 18, maxLife: 18 });
}

function drawMiniCharacterSprite(ctx, charId, x, y, scale = 1.0) {
  ctx.save(); ctx.translate(x, y); ctx.scale(scale, scale);
  if (charId === 1) { ctx.fillStyle = "#8e44ad"; ctx.fillRect(-11, -8, 5, 14); ctx.fillStyle = "#2980b9"; ctx.fillRect(-6, -6, 12, 13); ctx.fillStyle = "#f8c291"; ctx.beginPath(); ctx.arc(0, -12, 7, 0, Math.PI * 2); ctx.fill(); }
  else if (charId === 2) { ctx.fillStyle = "#e67e22"; ctx.fillRect(-8, -15, 6, 6); ctx.fillStyle = "#f8c291"; ctx.beginPath(); ctx.arc(0, -12, 7, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#ff7675"; ctx.fillRect(-6, -5, 12, 15); }
  else if (charId === 3) { ctx.fillStyle = "#1e272e"; ctx.fillRect(-7, -18, 14, 5); ctx.fillStyle = "#f8c291"; ctx.beginPath(); ctx.arc(0, -12, 7, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#1e3799"; ctx.fillRect(-7, -5, 14, 16); }
  else if (charId === 4) { ctx.fillStyle = "#2d3436"; ctx.fillRect(-8, -18, 16, 5); ctx.fillStyle = "#e17055"; ctx.beginPath(); ctx.arc(0, -11, 7, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#b71540"; ctx.fillRect(-9, -4, 18, 16); }
  else if (charId === 5) { ctx.fillStyle = "#2c2c54"; ctx.beginPath(); ctx.arc(0, -14, 8, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#f8c291"; ctx.beginPath(); ctx.arc(0, -12, 7, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#f5f6fa"; ctx.fillRect(-6, -5, 12, 16); }
  else { ctx.fillStyle = "#b33939"; ctx.beginPath(); ctx.arc(0, -13, 8, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#f8c291"; ctx.beginPath(); ctx.arc(0, -12, 6, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = "#fab1a0"; ctx.fillRect(-6, -5, 12, 14); }
  ctx.restore();
}

// 路線 A 改為「人型帶有突變觸手感」 (問題 2 實裝)
function drawBoss2DSprite(ctx, route, x, y) {
  ctx.save(); ctx.translate(x, y);
  if (route === "A") {
    ctx.shadowBlur = 18; ctx.shadowColor = "#ff4757";
    // 人型身體
    ctx.fillStyle = "#800e13"; ctx.fillRect(-8, -10, 16, 22);
    // 頭部與紅眼
    ctx.fillStyle = "#5c060a"; ctx.beginPath(); ctx.arc(0, -16, 8, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "#fffa65"; ctx.beginPath(); ctx.arc(-3, -17, 2, 0, Math.PI*2); ctx.arc(3, -17, 2, 0, Math.PI*2); ctx.fill();
    // 突變觸手伸展
    ctx.strokeStyle = "#ff4757"; ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(-8, -4); ctx.quadraticCurveTo(-22, -10, -28, -2);
    ctx.moveTo(8, -4); ctx.quadraticCurveTo(22, -10, 28, -2);
    ctx.moveTo(-8, 8); ctx.quadraticCurveTo(-20, 18, -26, 12);
    ctx.moveTo(8, 8); ctx.quadraticCurveTo(20, 18, 26, 12);
    ctx.stroke();
  } else if (route === "B") {
    ctx.shadowBlur = 18; ctx.shadowColor = "#38ada9";
    ctx.fillStyle = "#1e272e"; ctx.strokeStyle = "#00d2d3"; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.rect(-18, -18, 36, 36); ctx.fill(); ctx.stroke();
  } else {
    ctx.shadowBlur = 18; ctx.shadowColor = "#8e44ad";
    ctx.fillStyle = "#0c2461"; ctx.fillRect(-10, -5, 20, 24);
  }
  ctx.restore();
}

function drawMap() {
  const cvs = document.getElementById("gameCanvas");
  if (!cvs) return;
  const ctx = cvs.getContext("2d");
  ctx.clearRect(0, 0, cvs.width, cvs.height);

  const curP = getCurPlayer();
  const ox = CANVAS_CENTER - (curP ? curP.pos.x : 0) * TILE_SIZE;
  const oy = CANVAS_CENTER - (curP ? curP.pos.y : 0) * TILE_SIZE;

  for (let k in mapGrid) {
    const t = mapGrid[k];
    const px = t.x * TILE_SIZE + ox - TILE_SIZE/2;
    const py = t.y * TILE_SIZE + oy - TILE_SIZE/2;

    ctx.fillStyle = t.explored ? "#1b2130" : "#111520";
    if (electrifiedRoomKey === k) ctx.fillStyle = "#8e44ad";
    ctx.fillRect(px, py, TILE_SIZE, TILE_SIZE);
    ctx.strokeStyle = "#47526d"; ctx.lineWidth = 2;
    if (!t.doors.top) drawLine(ctx, px, py, px+TILE_SIZE, py);
    if (!t.doors.right) drawLine(ctx, px+TILE_SIZE, py, px+TILE_SIZE, py+TILE_SIZE);
    if (!t.doors.bottom) drawLine(ctx, px, py+TILE_SIZE, px+TILE_SIZE, py+TILE_SIZE);
    if (!t.doors.left) drawLine(ctx, px, py, px, py+TILE_SIZE);

    ctx.fillStyle = "#8395a7"; ctx.font = "9px sans-serif";
    ctx.fillText(t.name.substring(0, 4), px + 4, py + 12);

    const pb = powerBoxes.find(b => b.x === t.x && b.y === t.y);
    if (pb) {
      ctx.fillStyle = pb.active ? "#f1c40f" : "#7f8c8d";
      ctx.fillText(pb.active ? "⚡變電箱" : "🔌已關閉", px + 12, py + 52);
    }
  }

  drones.forEach(d => {
    const dx = d.x * TILE_SIZE + ox, dy = d.y * TILE_SIZE + oy;
    ctx.fillStyle = "#3498db"; ctx.beginPath(); ctx.arc(dx, dy, 8, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "#fff"; ctx.font = "7px sans-serif"; ctx.fillText("無人機", dx-12, dy+14);
  });
  cultists.forEach(c => {
    const cx = c.x * TILE_SIZE + ox, cy = c.y * TILE_SIZE + oy;
    ctx.fillStyle = "#8e44ad"; ctx.beginPath(); ctx.arc(cx, cy, 9, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "#fff"; ctx.font = "7px sans-serif"; ctx.fillText("黑暗信徒", cx-14, cy+15);
  });

  if (activeBoss) {
    const bx = activeBoss.x * TILE_SIZE + ox; const by = activeBoss.y * TILE_SIZE + oy;
    drawBoss2DSprite(ctx, activeBoss.route, bx, by);
    ctx.fillStyle = "#ff4757"; ctx.font = "bold 9px sans-serif"; ctx.fillText("BOSS", bx - 11, by - 24);
  }

  players.forEach((pl, idx) => {
    const px = pl.pos.x * TILE_SIZE + ox; const py = pl.pos.y * TILE_SIZE + oy;
    const isCur = (idx === currentPlayerIndex);

    ctx.save();
    if (isCur) {
      ctx.shadowBlur = 10; ctx.shadowColor = pl.color;
      ctx.fillStyle = "rgba(255, 165, 2, 0.4)";
      ctx.beginPath(); ctx.ellipse(px, py + 10, 14, 6, 0, 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();

    ctx.save();
    if (pl.isDead) ctx.filter = "grayscale(1) opacity(0.5)";
    drawMiniCharacterSprite(ctx, pl.id, px, py, 1.05);
    ctx.restore();

    ctx.fillStyle = isCur ? pl.color : "#cbd5e0";
    ctx.font = isCur ? "bold 10px sans-serif" : "8px sans-serif";
    ctx.textAlign = "center"; ctx.fillText(`P${pl.playerNum} ${pl.name}`, px, py - 18);
    ctx.textAlign = "left";
  });

  for (let i = visualEffects.length - 1; i >= 0; i--) {
    const fx = visualEffects[i];
    const fxX = fx.x * TILE_SIZE + ox, fxY = fx.y * TILE_SIZE + oy;
    if (fx.type === "text") {
      ctx.save(); ctx.font = `bold ${fx.size}px sans-serif`; ctx.fillStyle = fx.color; ctx.globalAlpha = fx.alpha;
      ctx.shadowBlur = 8; ctx.shadowColor = fx.color; ctx.fillText(fx.text, fxX - 18, fxY + fx.offsetY); ctx.restore();
      fx.offsetY -= 0.8; fx.alpha -= 0.025; fx.life--; if (fx.life <= 0) visualEffects.splice(i, 1);
    } else if (fx.type === "slash") {
      const progress = 1 - (fx.life / fx.maxLife);
      ctx.save(); ctx.strokeStyle = fx.color; ctx.lineWidth = 4 * (1 - progress); ctx.shadowBlur = 12; ctx.shadowColor = fx.color;
      ctx.beginPath(); ctx.moveTo(fxX - 25, fxY - 25); ctx.lineTo(fxX + 25, fxY + 25); ctx.moveTo(fxX + 25, fxY - 25); ctx.lineTo(fxX - 25, fxY + 25); ctx.stroke(); ctx.restore();
      fx.life--; if (fx.life <= 0) visualEffects.splice(i, 1);
    }
  }
}

function drawLine(ctx, x1, y1, x2, y2) { ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); }
function gameLoop() { drawMap(); requestAnimationFrame(gameLoop); }
function log(msg, type="normal") { gameLogs.push(msg); if (gameLogs.length > 50) gameLogs.shift(); }
function closeModal() { document.getElementById("modal").style.display = "none"; modalState = null; }
function handleGlobalKeyInput(e) {
  if (e.key === "ArrowUp" || e.key === "w") tryMove(0, -1);
  if (e.key === "ArrowDown" || e.key === "s") tryMove(0, 1);
  if (e.key === "ArrowLeft" || e.key === "a") tryMove(-1, 0);
  if (e.key === "ArrowRight" || e.key === "d") tryMove(1, 0);
  if (e.key === " " || e.key === "Enter") endTurn();
}
function setupTouchSwipe() {
  const cvs = document.getElementById('gameCanvas');
  let sx = 0, sy = 0;
  cvs.addEventListener('touchstart', e => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, {passive:true});
  cvs.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > Math.abs(dy)) {
      if (Math.abs(dx) > 30) tryMove(dx > 0 ? 1 : -1, 0);
    } else {
      if (Math.abs(dy) > 30) tryMove(0, dy > 0 ? 1 : -1);
    }
  }, {passive:true});
}
</script>
