function startAnimatedDiceRoll() {
  const btn = document.getElementById("btnRollDice"); if (btn) btn.disabled = true;
  const diceBox = document.getElementById("diceBox");
  if (diceBox) diceBox.classList.add("dice-rolling");
  let counter = 0;
  const itv = setInterval(() => {
    if (diceBox) diceBox.innerText = Math.floor(Math.random() * 6) + 1;
    counter++; SFX.diceRoll();
    if (counter > 14) { clearInterval(itv); finalizeDiceRoll(); }
  }, 70);
}

function finalizeDiceRoll() {
  const p = getCurPlayer();
  const ev = currentEvent;
  const diceBox = document.getElementById("diceBox");
  if (diceBox) diceBox.classList.remove("dice-rolling");

  const finalRoll = Math.floor(Math.random() * 6) + 1;
  if (diceBox) diceBox.innerText = finalRoll;

  let effectiveAttr = p[ev.stat];
  const total = finalRoll + effectiveAttr;
  const isSuccess = total >= ev.target;
  const statChinese = { str: "力氣", spd: "速度", kno: "知識", san: "心智" }[ev.stat];
  const content = document.getElementById("modal-content");

  if (!isSuccess && p.id === 3 && !p.hasRerolled) {
    p.hasRerolled = true;
    setTimeout(() => {
      content.innerHTML = `
        <div class="dice-stage"><div class="dice-box" style="border-color:#ffa502; color:#ffa502;">${finalRoll}</div></div>
        <h4 style="color:#70a1ff; font-size:1rem; margin:6px 0;">💼 浩偉【臨場冷靜】發動！</h4>
        <p style="font-size:0.78rem; color:#cbd5e0; margin-bottom:10px;">檢定未過，獲得一次重骰機會！</p>
        <button id="btnRollDice" onclick="startAnimatedDiceRoll()" style="background:#70a1ff; color:#111; padding:8px 24px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">🎲 立即重骰！</button>
      `;
    }, 350);
    return;
  }

  setTimeout(() => {
    if (isSuccess) {
      SFX.diceSuccess();
      content.innerHTML = `
        <div class="dice-stage"><div class="dice-box" style="border-color:#2ed573; color:#2ed573;">${finalRoll}</div></div>
        <div style="background:rgba(46, 213, 115, 0.15); border:1px solid #2ed573; padding:8px; border-radius:5px; margin:8px 0; font-size:0.8rem;">
          🎉 <b>檢定大成功！</b> 🎲 骰出 ${finalRoll} + ${statChinese}(${effectiveAttr}) = <b>${total} 點</b> (門檻 ≥ ${ev.target})
        </div>
        <p style="font-size:0.82rem; text-align:left;">${ev.win}</p>
        <button onclick="closeModal()" style="background:#2ed573; color:#111; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; margin-top:8px; cursor:pointer;">收起回神</button>
      `;
      p[ev.stat] += 1;
    } else {
      SFX.diceFail();
      content.innerHTML = `
        <div class="dice-stage"><div class="dice-box" style="border-color:#ff4757; color:#ff4757;">${finalRoll}</div></div>
        <div style="background:rgba(255, 71, 87, 0.15); border:1px solid #ff4757; padding:8px; border-radius:5px; margin:8px 0; font-size:0.8rem;">
          💥 <b>檢定失敗！</b> 🎲 骰出 ${finalRoll} + ${statChinese}(${effectiveAttr}) = <b>${total} 點</b> (未達門檻 ${ev.target})
        </div>
        <p style="font-size:0.82rem; text-align:left;">${ev.lose}</p>
        <button onclick="closeModal()" style="background:#57606f; color:#fff; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; margin-top:8px; cursor:pointer;">承受後果</button>
      `;
      if (ev.lose.includes("心智")) p.san = Math.max(0, p.san - 1);
      else applyDamageToPlayer(p, 2, ev.title);
    }
    updateUI();
  }, 350);
}

function checkBossTrigger(tile) {
  if (gamePhase === "combat") return false;
  const allTeamItems = [];
  players.forEach(pl => allTeamItems.push(...pl.inventory));

  const hasA = allTeamItems.some(i => i.id === "item_01");
  const hasB = allTeamItems.some(i => i.id === "item_03");
  const hasC = allTeamItems.some(i => i.id === "item_05");

  let triggeredRoute = null;
  if (hasA && (tile.name.includes("實驗室") || tile.name.includes("品管"))) triggeredRoute = "A";
  else if (hasB && (tile.name.includes("機房") || tile.name.includes("研發"))) triggeredRoute = "B";
  else if (hasC && (tile.name.includes("大會堂") || tile.name.includes("總經理"))) triggeredRoute = "C";
  else if (totalRoomsExplored >= 12 && (hasA || hasB || hasC)) triggeredRoute = hasA ? "A" : (hasB ? "B" : "C");

  if (triggeredRoute) {
    tile.hasItem = null; tile.hasEvent = null;
    showBossIntroStoryModal(triggeredRoute, tile);
    return true;
  }
  return false;
}

