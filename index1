  .inline-item-card { background: #1b2233; border-radius: 3px; padding: 2px 4px; display: flex; justify-content: space-between; align-items: center; font-size: 0.65rem; }
  .inline-item-name { color: #ffa502; font-weight: bold; cursor: pointer; text-decoration: underline; }
  .inline-use-btn { background: #2ed573; color: #111; border: none; padding: 1px 5px; border-radius: 2px; font-weight: bold; font-size: 0.6rem; cursor: pointer; }
  .quick-tools-row { display: flex; gap: 3px; margin-top: 2px; }
  .quick-btn { flex: 1; background: #202738; border: 1px solid #3b4660; color: #cbd5e0; padding: 4px 2px; border-radius: 3px; font-size: 0.65rem; font-weight: bold; cursor: pointer; }
  .dash-right-box {
    flex: 1.1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(0,0,0,0.3);
