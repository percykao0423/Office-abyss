  .char-select-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
  .char-card { background: #232a3b; padding: 8px; border-radius: 6px; cursor: pointer; border: 1.5px solid #36415a; text-align: left; display: flex; gap: 8px; align-items: center; }
