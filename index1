      <button type="button" onclick="closeModal()" style="background:#2ed573; color:#111; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; cursor:pointer; margin-top:10px;">回神挺住</button>
    `;
    log(`🧠【${targetP.name}】心智檢定大成功 (${total} > 8)！完全免除代理執行長的心智侵蝕！`, "talent");
  } else {
    SFX.diceFail();
    let sanDmg = 8 - total;
    if (targetP.inventory.some(i => i.id === "item_holy_necklace")) {
      sanDmg = Math.max(1, sanDmg - 1);
      log(`✨ 神聖項鍊為【${targetP.name}】抵擋了 1 點心智傷害！`, "item");
    }
    targetP.san = Math.max(0, targetP.san - sanDmg);
    addFloatingText(targetP.pos.x, targetP.pos.y, `-${sanDmg} 心智!`, "#8e44ad", 22);
    triggerScreenShake(7);
    triggerDamageFlash("player");

    content.innerHTML = `
      <div style="color:#ff4757; font-weight:bold; font-size:1rem; margin-bottom:8px;">
        💥 心智檢定失敗！(骰出 ${roll} + 心智 ${targetP.san} = ${total} ≤ 8)
      </div>
      <p style="font-size:0.82rem; color:#cbd5e0;">受到數值差額心智傷害：<b>8 - ${total} = ${sanDmg} 點心智損失！</b> (剩餘心智: ${targetP.san})</p>
      <button type="button" onclick="closeModal()" style="background:#57606f; color:#fff; padding:7px 22px; font-weight:bold; border:none; border-radius:5px; cursor:pointer; margin-top:10px;">承受心智折磨</button>
    `;
    log(`🧠【${targetP.name}】心智檢定失敗 (${total} ≤ 8)！失去 ${sanDmg} 點心智！`, "boss");
    if (targetP.san <= 0) checkPlayerDown(targetP);
  }
  updateUI();
}

