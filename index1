<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>異度家庭日 - The Office Abyss (V24 旗艦直式終極版)</title>
<style>
  :root {
    --bg-color: #0b0d14;
    --panel-bg: #141824;
    --accent: #ff4757;
    --text: #e0e6ed;
    --border: #262e40;
    --highlight: #2ed573;
    --gold: #ffa502;
    --player-theme: #ffa502;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-tap-highlight-color: transparent; }
  body {
    background-color: var(--bg-color);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft JhengHei", sans-serif;
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  header {
    background: #121520;
    padding: 6px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    height: 34px;
  }
  .header-title { font-weight: bold; font-size: 0.88rem; color: #ffa502; display: flex; align-items: center; gap: 6px; }

  /* 頂部玩家輪流行動狀態條 */
  .turn-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #1a2030;
    border-bottom: 2px solid var(--player-theme);
    padding: 2px 10px;
    font-size: 0.75rem;
    font-weight: bold;
    flex-shrink: 0;
    height: 28px;
  }
  .player-tab-list { display: flex; gap: 4px; overflow-x: auto; white-space: nowrap; }
  .player-tab {
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.68rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid transparent;
    color: #a0aec0;
  }
  .player-tab.active-tab {
    border-color: var(--player-theme);
    background: rgba(255,255,255,0.15);
    color: #fff;
    font-weight: bold;
  }

  /* 直式主架構 */
  .game-layout {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  /* 上半部：放大後的迷宮畫布 (約佔螢幕 50%) */
  .center-canvas-wrapper {
    flex: 1;
    min-height: 220px;
    max-height: 50vh;
    max-height: 50dvh;
    position: relative;
    background: #06070a;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 2px;
  }
  canvas#gameCanvas {
    background: #0f121d;
    box-shadow: 0 0 15px rgba(0,0,0,0.85);
    border: 1px solid var(--border);
    max-height: 98%;
    max-width: 98%;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
  }

  /* 下半部：零滾動雙分割操控台 (約佔螢幕 46%) */
  .bottom-dashboard {
    height: 46vh;
    height: 46dvh;
    background: var(--panel-bg);
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: row;
    padding: 5px;
    gap: 5px;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* 左半部：狀態卡、剩餘步數大徽章、中文化屬性、內嵌滾動道具欄 */
  .dash-left-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px;
    overflow: hidden;
  }
  .char-compact-row {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  canvas#active-char-canvas {
    background: rgba(0,0,0,0.3);
    border-radius: 4px;
    border: 1px solid #3c445c;
    flex-shrink: 0;
  }
  .char-summary { flex: 1; min-width: 0; }
  .char-name-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    font-weight: bold;
  }
  .hp-bar-container {
    background: #232733;
    border-radius: 3px;
    overflow: hidden;
    height: 7px;
    margin-top: 2px;
    border: 1px solid #3c445c;
  }
  .hp-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #e74c3c, #2ed573);
    width: 100%;
    transition: width 0.3s ease;
  }

  /* 醒目常駐步數標籤 */
  .step-badge {
    background: #10141f;
    border: 1.5px solid #2ed573;
    color: #2ed573;
    padding: 3px 5px;
    border-radius: 4px;
    text-align: center;
    font-weight: 900;
    font-size: 0.78rem;
    margin: 3px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .step-badge.no-steps {
    border-color: #ff4757 !important;
    color: #ff4757 !important;
    background: rgba(255, 71, 87, 0.15) !important;
  }

  .stat-grid-compact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    font-size: 0.65rem;
    margin-bottom: 3px;
  }
  .stat-pill {
    background: rgba(255,255,255,0.04);
    padding: 2px 3px;
    border-radius: 3px;
    border: 1px solid #232a3a;
  }
  .stat-val { font-weight: bold; color: #ffa502; float: right; }

  /* 內嵌可滾動道具欄 */
  .inline-inventory-box {
    background: #10141f;
    border: 1px solid #28324a;
    border-radius: 4px;
    max-height: 85px;
    overflow-y: auto;
    padding: 3px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .inline-item-card {
    background: #1b2233;
    border-radius: 3px;
    padding: 2px 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
  }
  .inline-item-name { color: #ffa502; font-weight: bold; cursor: pointer; text-decoration: underline; }
  .inline-use-btn {
    background: #2ed573; color: #111; border: none; padding: 1px 5px; border-radius: 2px; font-weight: bold; font-size: 0.6rem; cursor: pointer;
  }

  .quick-tools-row { display: flex; gap: 3px; margin-top: 2px; }
  .quick-btn {
    flex: 1;
    background: #202738;
    border: 1px solid #3b4660;
    color: #cbd5e0;
    padding: 4px 2px;
    border-radius: 3px;
    font-size: 0.65rem;
    font-weight: bold;
    cursor: pointer;
  }

  /* 右半部：虛擬方向鍵與結束回合按鈕 */
  .dash-right-box {
    flex: 1.1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px;
  }
  .boss-mini-bar {
    display: none;
    background: rgba(255, 71, 87, 0.15);
    border: 1px solid #ff4757;
    border-radius: 4px;
    padding: 2px 4px;
    margin-bottom: 2px;
    font-size: 0.65rem;
    justify-content: space-between;
    align-items: center;
  }
  .control-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }
  .control-grid button {
    background: #252c3d;
    color: white;
    border: 1px solid #3d4a66;
    padding: 10px 2px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.8rem;
    touch-action: manipulation;
  }
  .control-grid button:active { background: #4a5a7d; transform: scale(0.96); }
  .btn-turn {
    background: #d63031 !important;
    border-color: #ff7675 !important;
    width: 100%;
    padding: 7px 2px !important;
    font-size: 0.75rem !important;
    margin-top: 2px;
  }

  /* 浮動抽屜 (日誌) */
  .drawer-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    z-index: 500;
    display: none;
    justify-content: center;
    align-items: flex-end;
  }
  .drawer-content {
    background: #181f2f;
    border-top: 2px solid var(--player-theme);
    border-radius: 12px 12px 0 0;
    width: 100%;
    max-height: 65vh;
    padding: 14px;
    overflow-y: auto;
  }

  /* 戰鬥畫面震動與閃光特效 */
  .shake-screen { animation: screenShake 0.35s ease-in-out; }
  @keyframes screenShake {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(-6px, 4px); }
    40% { transform: translate(6px, -4px); }
    60% { transform: translate(-4px, -2px); }
    80% { transform: translate(4px, 2px); }
  }
  .flash-red {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255, 0, 0, 0.35); pointer-events: none; z-index: 50;
    animation: fadeOut 0.4s forwards;
  }
  .flash-white {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255, 255, 255, 0.45); pointer-events: none; z-index: 50;
    animation: fadeOut 0.3s forwards;
  }
  @keyframes fadeOut { 0% { opacity: 1; } 100% { opacity: 0; } }

  /* 彈窗樣式 */
  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.88); display: flex; justify-content: center; align-items: center; z-index: 9999;
  }
  .modal-box {
    background: #1a202c; border: 2px solid #4a5568; border-radius: 10px;
    width: 580px; max-width: 94vw; padding: 16px; text-align: center; max-height: 90vh; overflow-y: auto;
  }
  .char-select-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px;
  }
  .char-card {
    background: #232a3b; padding: 8px; border-radius: 6px; cursor: pointer;
    border: 1.5px solid #36415a; text-align: left; display: flex; gap: 8px; align-items: center;
  }
  .char-card.disabled-char { opacity: 0.35; filter: grayscale(1); }
  .dice-stage {
    display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 10px 0;
  }
  .dice-box {
    width: 70px; height: 70px; background: #ffffff; color: #111; border-radius: 12px;
    display: flex; justify-content: center; align-items: center; font-size: 2.4rem; font-weight: 900; border: 3px solid #ff4757;
  }
  .dice-rolling { animation: diceRollAnim 0.12s infinite alternate; }
  @keyframes diceRollAnim {
    0% { transform: scale(1.08) rotate(-12deg); }
    100% { transform: scale(0.96) rotate(12deg); }
  }
  .story-narrative {
    text-align: left; font-size: 0.84rem; line-height: 1.6; color: #e2e8f0;
    background: rgba(0,0,0,0.35); border-left: 3px solid #ffa502; padding: 10px 12px; border-radius: 4px; margin: 10px 0; max-height: 240px; overflow-y: auto;
  }
</style>
</head>
