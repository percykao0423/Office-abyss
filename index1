<script>
let audioCtx = null, bgmGain = null, sfxGain = null, isAudioMuted = false;
function initAudio() {
  if (!audioCtx) {
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AudioContext();
    bgmGain = audioCtx.createGain(); bgmGain.gain.value = 0.2; bgmGain.connect(audioCtx.destination);
    sfxGain = audioCtx.createGain(); sfxGain.gain.value = 0.35; sfxGain.connect(audioCtx.destination);
  }
  if (audioCtx.state === "suspended") audioCtx.resume();
}
function toggleAudio() {
  isAudioMuted = !isAudioMuted;
  document.getElementById("btn-audio-toggle").innerText = isAudioMuted ? "🔇 音效: 靜音" : "🔊 音效: 開啟";
  if (audioCtx) { bgmGain.gain.value = isAudioMuted ? 0 : 0.2; sfxGain.gain.value = isAudioMuted ? 0 : 0.35; }
}
function playTone(freq, dur, type="sine") {
  if (!audioCtx || isAudioMuted) return;
  try {
    const o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.type = type; o.frequency.setValueAtTime(freq, audioCtx.currentTime);
    g.gain.setValueAtTime(0.25, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    o.connect(g); g.connect(sfxGain); o.start(); o.stop(audioCtx.currentTime + dur);
  } catch(e) {}
}
function playNoise(dur = 0.2, gainVal = 0.3) {
  if (!audioCtx || isAudioMuted) return;
  try {
    const bufferSize = audioCtx.sampleRate * dur;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const output = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) output[i] = Math.random() * 2 - 1;
    const whiteNoise = audioCtx.createBufferSource(); whiteNoise.buffer = buffer;
    const g = audioCtx.createGain(); g.gain.setValueAtTime(gainVal, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    whiteNoise.connect(g); g.connect(sfxGain); whiteNoise.start();
  } catch(e) {}
}

const SFX = {
  click: () => playTone(520, 0.05),
  move: () => playTone(280, 0.06, "triangle"),
  switchTurn: () => playTone(440, 0.08),
  itemPickup: () => { playTone(440, 0.1); setTimeout(() => playTone(660, 0.15), 80); setTimeout(() => playTone(880, 0.25), 160); },
  diceRoll: () => playTone(300 + Math.random() * 200, 0.03, "square"),
  diceSuccess: () => playTone(784, 0.2),
  diceFail: () => playTone(220, 0.25, "sawtooth"),
  punchAttack: () => { playNoise(0.18, 0.45); playTone(180, 0.15, "sawtooth", 0.35); },
  bladeSlash: () => { playTone(920, 0.12, "sawtooth", 0.35); playNoise(0.12, 0.3); },
  bossHitPlayer: () => { playNoise(0.3, 0.55); playTone(130, 0.35, "sawtooth", 0.5); },
  bossRoar: () => { playTone(110, 0.7, "sawtooth", 0.5); playNoise(0.65, 0.4); },
  alarm: () => { playTone(880, 0.2, "sawtooth"); setTimeout(() => playTone(660, 0.2, "sawtooth"), 200); }
