function resolveDamageChoice(statType, amount) {
  SFX.hit();
  const p = getCurPlayer();
  if (statType === 'str') {
    p.str = Math.max(1, p.str - amount);
    log(`💥【${p.name}】選擇扣除【力氣】-${amount} (剩餘: ${p.str})`, "boss");
  } else {
    p.spd = Math.max(1, p.spd - amount);
    p.currentSteps = Math.min(p.currentSteps, p.spd);
    log(`💥【${p.name}】選擇扣除【速度】-${amount} (剩餘: ${p.spd})`, "boss");
  }
  p.hp = Math.max(0, (p.str + p.spd) - amount); // 調整 HP
  triggerScreenShake(7); triggerDamageFlash("player");
  closeModal();
  if (p.hp <= 0 || p.str + p.spd <= 2) checkPlayerDown(p);
  updateUI();
}

