function generateTile(x, y, fromDir) {
  const name = ROOM_NAMES[Math.floor(Math.random() * ROOM_NAMES.length)];
  const tile = new Tile(x, y, name);
  
  if (fromDir === "top") tile.doors.bottom = true;
  if (fromDir === "bottom") tile.doors.top = true;
  if (fromDir === "left") tile.doors.right = true;
  if (fromDir === "right") tile.doors.left = true;
  ["top", "right", "bottom", "left"].forEach(d => { if (Math.random() < 0.65) tile.doors[d] = true; });

  const rand = Math.random();
  if (rand < 0.45) {
    tile.hasEvent = EVENTS_POOL[Math.floor(Math.random() * EVENTS_POOL.length)];
  } else if (rand < 0.78) {
    const availableItems = ITEMS_POOL.filter(item => {
      if (!item.isKey) return true;
      return !claimedGlobalItemIds.has(item.id);
    });
    if (availableItems.length > 0) {
      const selected = availableItems[Math.floor(Math.random() * availableItems.length)];
      tile.hasItem = JSON.parse(JSON.stringify(selected));
      if (selected.isKey) claimedGlobalItemIds.add(selected.id);
    } else {
      tile.hasItem = JSON.parse(JSON.stringify(ITEMS_POOL.find(i => i.id === "item_med")));
    }
  }

  totalRoomsExplored++;
  return tile;
}

function tryMove(dx, dy) {
  const p = getCurPlayer();
  if (!p || p.isDead || modalState !== null) return;

  if (p.currentSteps <= 0) {
    log(`⚠️ P${p.playerNum} 步數已用盡！請點擊【換下一位行動】結束回合。`, "event");
    triggerScreenShake(3);
    return;
  }

  const curTile = mapGrid[`${p.pos.x},${p.pos.y}`];
  let dir = dx===0 ? (dy===-1?"top":"bottom") : (dx===-1?"left":"right");
  if (!curTile.doors[dir]) {
    log("碰！眼前是厚實水泥牆！", "event");
    triggerScreenShake(3);
    return;
  }

  const targetKey = `${p.pos.x+dx},${p.pos.y+dy}`;
  let targetTile = mapGrid[targetKey];
  let isFirstEnter = false;

  if (!targetTile) {
    targetTile = generateTile(p.pos.x+dx, p.pos.y+dy, dir);
    mapGrid[targetKey] = targetTile;
    isFirstEnter = true;
  }

  p.pos.x += dx; p.pos.y += dy;
  p.currentSteps--;
  SFX.move();

  if (electrifiedRoomKeys.includes(`${p.pos.x},${p.pos.y}`)) {
    p.currentSteps = Math.max(0, p.currentSteps - 1);
    log(`⚡ 踩入 AI母體高壓通電房間！受到 1 點肉體傷害，額外多消耗 1 步！`, "boss");
    applyDamageToPlayer(p, 1, "通電地板高壓電弧");
  }

  updateUI();
  log(`【P${p.playerNum} ${p.name}】踏入【${targetTile.name}】(剩餘步數: ${p.currentSteps})`, "action");

  if (isFirstEnter) {
    targetTile.explored = true;
    if (checkBossTrigger(targetTile)) return;
    
    if (targetTile.hasItem) {
      showItemPickupModal(targetTile.hasItem);
      targetTile.hasItem = null;
      p.currentSteps = 0;
      updateUI();
      return;
    }
    if (targetTile.hasEvent) {
      triggerEvent(targetTile.hasEvent);
      targetTile.hasEvent = null;
      p.currentSteps = 0;
      updateUI();
      return;
    }
  }
}

let pendingDamagePlayer = null;
let pendingDamageAmount = 0;

function applyDamageToPlayer(targetP, amount, reason = "受到傷害") {
  if (!targetP || targetP.isDead) return;

  if (targetP.id === 4 && (targetP.hp - amount) <= 0 && !targetP.ironBodyUsed) {
    targetP.ironBodyUsed = true;
    targetP.hp = 1;
    log(`🛡️ 大東爆發【結實的身體】！硬扛致死打擊，血量強制鎖定為 1！`, "talent");
    addFloatingText(targetP.pos.x, targetP.pos.y, "LOCK 1 HP!", "#ffa502", 22);
    triggerScreenShake(8);
    triggerDamageFlash("player");
    updateUI();
    return;
  }

  if (targetP.id === 1 && amount >= 3 && Math.random() < 0.5) {
    SFX.click();
    log(`🏃‍♂️ 翔翔觸發【捉迷藏】！靈活閃避了致命傷害！`, "talent");
    addFloatingText(targetP.pos.x, targetP.pos.y, "DODGE!", "#2ed573", 22);
    triggerScreenShake(3);
    updateUI();
    return;
  }

  if (targetP.inventory.some(i => i.id === "item_bulletproof_vest")) {
    amount = Math.max(1, amount - 1);
    log(`🛡️ 防彈背心為【${targetP.name}】抵擋了 1 點肉體衝擊！`, "item");
  }

  pendingDamagePlayer = targetP;
  pendingDamageAmount = amount;
  modalState = "damage_choice";

  const content = document.getElementById("modal-content");
  document.getElementById("modal").style.display = "flex";

  content.innerHTML = `
    <h3 style="color:#ff4757; font-size:1.15rem;">💥 遭受重創：${reason}！</h3>
    <p style="font-size:0.82rem; color:#cbd5e0; margin:10px 0; line-height:1.5;">
      【${targetP.name}】受到 <b>${amount} 點肉體傷害</b>！<br>
      請選擇要扣除哪一項核心素質（力氣或速度，將同步扣除血量上限）：
    </p>
    <div style="display:flex; justify-content:center; gap:12px; margin-top:15px;">
      <button type="button" onclick="resolveDamageChoice('str')" style="background:#e74c3c; color:#fff; padding:10px 18px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">
        扣除【力氣】 (目前: ${targetP.str})
      </button>
      <button type="button" onclick="resolveDamageChoice('spd')" style="background:#3498db; color:#fff; padding:10px 18px; font-weight:bold; border:none; border-radius:5px; cursor:pointer;">
        扣除【速度】 (目前: ${targetP.spd})
      </button>
    </div>
  `;
}

function resolveDamageChoice(statType) {
  SFX.hit();
  const targetP = pendingDamagePlayer || getCurPlayer();
  const amount = pendingDamageAmount || 1;

  if (statType === 'str') {
    targetP.str = Math.max(1, targetP.str - amount);
    log(`💥【${targetP.name}】選擇扣除【力氣】-${amount} (剩餘力氣: ${targetP.str})`, "boss");
  } else {
    targetP.spd = Math.max(1, targetP.spd - amount);
    targetP.currentSteps = Math.min(targetP.currentSteps, targetP.spd);
    log(`💥【${targetP.name}】選擇扣除【速度】-${amount} (剩餘速度: ${targetP.spd})`, "boss");
  }

  targetP.maxHp = targetP.str + targetP.spd;
  targetP.hp = Math.max(0, targetP.hp - amount);
  triggerScreenShake(7);
  triggerDamageFlash("player");

  closeModal();

  if (targetP.hp <= 0) {
    checkPlayerDown(targetP);
  }
  updateUI();
  drawMap();
}

function applySanDamageToPlayer(targetP, amount, reason = "精神衝擊") {
  if (!targetP || targetP.isDead) return;

  if (targetP.inventory.some(i => i.id === "item_holy_necklace")) {
