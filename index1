function finalizeMentalRoll(pNum) {
  const targetP = players.find(pl => pl.playerNum === pNum);
  const diceBox = document.getElementById("mentalDiceBox");
  if (diceBox) diceBox.classList.remove("dice-rolling");
  const roll = Math.floor(Math.random() * 6) + 1;
  if (diceBox) diceBox.innerText = roll;
  const total = roll + targetP.san;
  const content = document.getElementById("modal-content");

  if (total > 8) {
    SFX.diceSuccess();
    addFloatingText(targetP.pos.x, targetP.pos.y, "RESIST / 0 SAN", "#70a1ff", 20);
    content.innerHTML = `
      <div style="color:#2ed573; font-weight:bold; font-size:1rem; margin-bottom:8px;">
        🎉 心智檢定大成功！(骰出 ${roll} + 心智 ${targetP.san} = ${total} > 8)
